# ─────────────────────────────────────────────────────────────
# Fresheri — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/fresheri?sslmode=require"
DIRECT_URL="postgresql://user:password@localhost:5432/fresheri?sslmode=require"

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth (JWT) ───────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=your_jwt_secret_min_32_chars
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Africa's Talking (SMS / USSD) ────────────────────────────
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox               # use "sandbox" for test mode
USSD_SERVICE_CODE=*384#
USSD_SESSION_TTL_MINUTES=5

# ── Frontend (web/) ──────────────────────────────────────────
# Base URL of the deployed Express backend
NEXT_PUBLIC_API_URL=https://fresheri-v6kz.vercel.app

# ── Flutterwave Payments ─────────────────────────────────────
# Test keys from https://developer.flutterwave.com (free account)
# Dashboard → Settings → API Keys → Test

# PUBLIC key — safe to expose in the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# SECRET key — NEVER expose in the browser; used only in API routes
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Webhook secret — set the same value in:
#   Flutterwave Dashboard → Settings → Webhooks → Secret Hash
# This value is checked on every incoming webhook request.
FLW_WEBHOOK_SECRET=your_flw_webhook_secret_hash

# Webhook URL to register in Flutterwave dashboard:
#   https://fresheri.vercel.app/api/webhooks/flutterwave
# (or your ngrok URL during local development)

# ── Internal webhook-to-backend secret ──────────────────────
# Used by the Next.js webhook route to authenticate calls to the
# Express backend's PATCH /orders/:id/payment endpoint.
# Set both here AND in the Vercel backend environment variables.
INTERNAL_WEBHOOK_SECRET=fresheri-internal-2024

# ── Seed (one-time DB bootstrap) ────────────────────────────
# Used by POST /seed?secret=… on the Express backend
SEED_SECRET=fresheri-seed-bootstrap-2024
